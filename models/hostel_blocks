// models/hostel_blocks.js
module.exports = function (sequelize, DataTypes) {
  return sequelize.define(
    "hostel_blocks",
    {
      id: {
        type: DataTypes.UUID,
        defaultValue: DataTypes.UUIDV4,
        primaryKey: true,
      },

      block_name: {
        type: DataTypes.STRING,
        allowNull: false,
      },

      gender: {
        type: DataTypes.ENUM("Male", "Female"),
        allowNull: false,
      },
    },
    {
      tableName: "hostel_blocks",
      timestamps: false,
    }
  );
};
